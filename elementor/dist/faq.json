rdion_border_active_border":"solid","accordion_border_active_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"accordion_border_active_color":"rgba(83,66,81,0.4)","title_typography_typography":"custom","title_typography_font_family":"Source Sans Pro","title_typography_font_weight":"600","title_typography_font_size":{"unit":"px","size":22,"sizes":[]},"title_typography_font_size_mobile":{"unit":"px","size":18,"sizes":[]},"title_typography_line_height":{"unit":"px","size":30,"sizes":[]},"title_typography_letter_spacing":{"unit":"px","size":-0.22,"sizes":[]},"normal_title_color":"#514150","hover_title_color":"#B4544E","active_title_color":"#514150","normal_icon_color":"#62B6CF","hover_icon_color":"#62B6CF","active_icon_color":"#62B6CF","icon_size":{"unit":"px","size":24,"sizes":[]},"content_padding":{"unit":"px","top":"0","right":"32","bottom":"28","left":"32","isLinked":false},"content_padding_mobile":{"unit":"px","top":"0","right":"20","bottom":"20","left":"20","isLinked":false},"_element_width":"initial","_element_custom_width":{"unit":"px","size":860,"sizes":[]},"_element_custom_width_tablet":{"unit":"%","size":100,"sizes":[]}},"elements":[{"id":"128f1e4","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"128d2f5","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>Yes — when it’s sourced, handled and stored properly. Our seafood is prepared hygienically and snap-frozen to lock in freshness. Keep it frozen until needed, thaw it in the fridge, and wash bowls and hands after serving, just as you would with any raw protein. If your pet has a health condition, check with your vet before changing their diet. <a href=\"https://rawpetfoods.wsdfy.com/why-real-seafood-is-more-attractive-for-pets/\">Why real seafood works for pets →</a></p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"1292fc2","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"12910d3","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>Delivered frozen to preserve raw nutrition. Simply thaw in the fridge before serving. Pop it straight in the freezer when it arrives and thaw only what you need. <a href=\"https://rawpetfoods.wsdfy.com/delivery-info/\">Delivery &amp; storage info →</a></p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"1296da0","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"1294eb1","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>No. Once thawed, keep it covered in the fridge and use it within the time shown on the pack. Refreezing thawed raw food affects both texture and food safety, so thaw one portion at a time.</p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"129ab7e","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"1298c8f","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>Go gradually over about 7–10 days. Start by swapping a small part of their usual meal for raw seafood, then increase the share each day while keeping an eye on their digestion. Puppies, kittens and pets with health conditions should switch under your vet’s guidance. <a href=\"https://rawpetfoods.wsdfy.com/how-to-tell-if-your-pets-food-is-truly-natural/\">What “natural” pet food really means →</a></p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"129e95c","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"129ca6d","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>We’re Australia’s first ocean-fresh raw seafood meals for pets: real seafood cuts like salmon belly fins instead of fillers, snap-frozen to lock in nutrition, vet-approved and responsibly sourced. <a href=\"https://rawpetfoods.wsdfy.com/sustainable-feeding-good-for-pets-better-for-the-planet/\">How we feed pets sustainably →</a></p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"12a273a","elType":"container","isInner":true,"settings":{"content_width":"full","flex_direction":"column"},"elements":[{"id":"12a084b","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>We’re expanding our delivery areas. Check <a href=\"https://rawpetfoods.wsdfy.com/delivery-info/\">Delivery Info</a> for the latest, or email <a href=\"mailto:orders@rawpetfoods.com.au\">orders@rawpetfoods.com.au</a> with your postcode and we’ll confirm delivery to you.</p>","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]}]},{"id":"12a4629","elType":"widget","widgetType":"text-editor","isInner":false,"settings":{"editor":"<p>Still have a question? Email <a href=\"mailto:orders@rawpetfoods.com.au\">orders@rawpetfoods.com.au</a> for orders and products, or <a href=\"mailto:info@rawpetfoods.com.au\">info@rawpetfoods.com.au</a> for everything else.</p>","align":"center","align_mobile":"center","__globals__":{"text_color":"globals/colors?id=text","typography_typography":"globals/typography?id=text"}},"elements":[]}]},{"id":"12ae0d4","elType":"container","isInner":false,"settings":{"content_width":"boxed","flex_direction":"column","flex_align_items":"center","flex_gap":{"unit":"px","size":20,"column":"20","row":"20","isLinked":true},"padding":{"unit":"px","top